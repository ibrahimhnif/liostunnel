/target
/target-linux
# Release archives assembled by packaging/make-bundle.sh. Rebuilt from a
# commit, never a source of truth, and each one is the whole app.
/dist
**/*.rs.bk
*.pdb

# Local profiles and secrets — never commit these
*.liostunnel.json
/testing/local/
known_hosts

testing/docker/sshd/keys/
testing/docker/ss/conf/
testing/docker/.env

.DS_Store

# Flutter
/app/build/
/app/.dart_tool/
/app/.flutter-plugins*
/app/linux/flutter/ephemeral/
/app/macos/Flutter/ephemeral/
/app/macos/Pods/

# Where the FRB-generated loader expects the cdylib. The workspace builds into
# a shared /target, so this is a staged copy, not a source of truth.
/crates/*/target/
